# ── Gemini API ──────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── Snowflake ───────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# ── Project ─────────────────────────────────────────────────────────────
PROJECT_OUTPUT_DIR=generated_projects
MAX_RETRIES=3
LOG_LEVEL=INFO
