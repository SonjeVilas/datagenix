# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual environments ───────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment / secrets ──────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Generated output ───────────────────────────────────────────────────
generated_projects/*
!generated_projects/.gitkeep
!generated_projects/retail_dbt_v1/
!generated_projects/retail_analytics_v2/

# Never commit real dbt profiles with credentials, artifacts, logs, or zips
generated_projects/*/profiles.yml
generated_projects/*/logs/
generated_projects/*/target/
generated_projects/*/.user.yml
generated_projects/*.zip

# Local SQLite database & runtime logs
storage/*
!storage/.gitkeep
logs/*
!logs/.gitkeep

# ── IDE / editor ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Testing / coverage ────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ── Misc ───────────────────────────────────────────────────────────────
*.log
*.bak
*.tmp
deploy_results.json
